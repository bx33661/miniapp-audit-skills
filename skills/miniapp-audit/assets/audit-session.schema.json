{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "Audit session and coverage",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "session_id",
    "created_at",
    "mode",
    "scope",
    "coverage",
    "limitations"
  ],
  "properties": {
    "session_id": {
      "type": "string",
      "minLength": 1,
      "pattern": "\\S"
    },
    "created_at": {
      "type": "string",
      "format": "date-time"
    },
    "mode": {
      "enum": [
        "focused",
        "full"
      ]
    },
    "input_path": {
      "type": "string",
      "minLength": 1,
      "pattern": "\\S"
    },
    "scope": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "in_scope",
        "out_of_scope",
        "environment",
        "authorization"
      ],
      "properties": {
        "in_scope": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "string",
            "minLength": 1,
            "pattern": "\\S"
          }
        },
        "out_of_scope": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1,
            "pattern": "\\S"
          },
          "uniqueItems": true
        },
        "environment": {
          "type": "string",
          "minLength": 1,
          "pattern": "\\S"
        },
        "authorization": {
          "type": "string",
          "minLength": 1,
          "pattern": "\\S"
        },
        "accounts": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1,
            "pattern": "\\S"
          },
          "uniqueItems": true
        },
        "data_handling": {
          "type": "string",
          "minLength": 1,
          "pattern": "\\S"
        }
      }
    },
    "coverage": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "asset",
          "test_type",
          "identity",
          "status",
          "evidence_refs"
        ],
        "properties": {
          "asset": {
            "type": "string",
            "minLength": 1,
            "pattern": "\\S"
          },
          "test_type": {
            "type": "string",
            "minLength": 1,
            "pattern": "\\S"
          },
          "identity": {
            "type": "string",
            "minLength": 1,
            "pattern": "\\S"
          },
          "status": {
            "enum": [
              "tested",
              "partial",
              "not_tested"
            ]
          },
          "evidence_refs": {
            "type": "array",
            "items": {
              "type": "string",
              "pattern": "^EV-[0-9]{3,}$"
            },
            "uniqueItems": true
          },
          "reason": {
            "type": "string",
            "minLength": 1,
            "pattern": "\\S"
          },
          "residual_risk": {
            "type": "string",
            "minLength": 1,
            "pattern": "\\S"
          }
        },
        "allOf": [
          {
            "if": {
              "properties": {
                "status": {
                  "enum": [
                    "tested",
                    "partial"
                  ]
                }
              }
            },
            "then": {
              "properties": {
                "evidence_refs": {
                  "minItems": 1
                }
              }
            }
          },
          {
            "if": {
              "properties": {
                "status": {
                  "enum": [
                    "partial",
                    "not_tested"
                  ]
                }
              }
            },
            "then": {
              "required": [
                "reason",
                "residual_risk"
              ]
            }
          }
        ]
      }
    },
    "limitations": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1,
        "pattern": "\\S"
      },
      "uniqueItems": true
    }
  }
}
