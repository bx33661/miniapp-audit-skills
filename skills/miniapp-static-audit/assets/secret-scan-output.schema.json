{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "Secret candidates",
  "description": "候选仅记录脱敏线索及核实结果，不凭模式匹配评定漏洞或严重性。",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "skill",
    "scanned_at",
    "source_dir",
    "secrets",
    "limitations"
  ],
  "properties": {
    "skill": {
      "const": "miniapp-static-audit"
    },
    "scanned_at": {
      "type": "string",
      "format": "date-time"
    },
    "source_dir": {
      "type": "string",
      "minLength": 1,
      "pattern": "\\S"
    },
    "tool_used": {
      "type": "string",
      "minLength": 1,
      "pattern": "\\S"
    },
    "tool_version": {
      "type": "string",
      "minLength": 1,
      "pattern": "\\S"
    },
    "secrets": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "evidence_id",
          "type",
          "value_masked",
          "file",
          "line",
          "review_status",
          "context"
        ],
        "properties": {
          "evidence_id": {
            "type": "string",
            "pattern": "^EV-[0-9]{3,}$"
          },
          "type": {
            "type": "string",
            "minLength": 1,
            "pattern": "\\S"
          },
          "value_masked": {
            "type": "string",
            "minLength": 1,
            "pattern": "\\S"
          },
          "file": {
            "type": "string",
            "minLength": 1,
            "pattern": "\\S"
          },
          "line": {
            "type": "integer",
            "minimum": 1
          },
          "review_status": {
            "enum": [
              "unreviewed",
              "relevant",
              "excluded"
            ]
          },
          "context": {
            "type": "string",
            "minLength": 1,
            "pattern": "\\S"
          },
          "rule_id": {
            "type": "string",
            "minLength": 1,
            "pattern": "\\S"
          },
          "reason": {
            "type": "string",
            "minLength": 1,
            "pattern": "\\S"
          }
        },
        "allOf": [
          {
            "if": {
              "properties": {
                "review_status": {
                  "enum": [
                    "relevant",
                    "excluded"
                  ]
                }
              }
            },
            "then": {
              "required": [
                "reason"
              ]
            }
          }
        ]
      }
    },
    "limitations": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1,
        "pattern": "\\S"
      },
      "uniqueItems": true
    }
  }
}
