{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "Privacy review results",
  "description": "按实际检查的领域记录结论与未知；合规观察不自动等同漏洞。",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "skill",
    "checked_at",
    "source_dir",
    "regulations",
    "sections",
    "limitations"
  ],
  "properties": {
    "skill": {
      "const": "miniapp-static-audit"
    },
    "checked_at": {
      "type": "string",
      "format": "date-time"
    },
    "source_dir": {
      "type": "string",
      "minLength": 1,
      "pattern": "\\S"
    },
    "regulations": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1,
        "pattern": "\\S"
      },
      "uniqueItems": true
    },
    "sections": {
      "type": "object",
      "minProperties": 1,
      "propertyNames": {
        "pattern": "^[a-z][a-z0-9_]*$"
      },
      "additionalProperties": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "status",
          "issues",
          "limitations"
        ],
        "properties": {
          "status": {
            "enum": [
              "reviewed",
              "partial",
              "not_tested"
            ]
          },
          "issues": {
            "type": "array",
            "items": {
              "$ref": "../../miniapp-report/assets/finding.schema.json"
            }
          },
          "limitations": {
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1,
              "pattern": "\\S"
            },
            "uniqueItems": true
          },
          "reason": {
            "type": "string",
            "minLength": 1,
            "pattern": "\\S"
          }
        },
        "allOf": [
          {
            "if": {
              "properties": {
                "status": {
                  "enum": [
                    "partial",
                    "not_tested"
                  ]
                }
              }
            },
            "then": {
              "required": [
                "reason"
              ],
              "properties": {
                "limitations": {
                  "minItems": 1
                }
              }
            }
          },
          {
            "if": {
              "properties": {
                "status": {
                  "const": "not_tested"
                }
              }
            },
            "then": {
              "properties": {
                "issues": {
                  "maxItems": 0
                }
              }
            }
          }
        ]
      }
    },
    "limitations": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1,
        "pattern": "\\S"
      },
      "uniqueItems": true
    }
  }
}
