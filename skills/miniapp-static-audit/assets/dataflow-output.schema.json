{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "dataflow review results",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "skill",
    "traced_at",
    "source_dir",
    "findings",
    "limitations"
  ],
  "properties": {
    "skill": {
      "const": "miniapp-static-audit"
    },
    "traced_at": {
      "type": "string",
      "format": "date-time"
    },
    "source_dir": {
      "type": "string",
      "minLength": 1,
      "pattern": "\\S"
    },
    "findings": {
      "type": "array",
      "items": {
        "$ref": "../../miniapp-report/assets/finding.schema.json"
      }
    },
    "limitations": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1,
        "pattern": "\\S"
      },
      "uniqueItems": true
    },
    "sources_catalog": {
      "type": "array",
      "items": {
        "type": "object"
      }
    },
    "sinks_catalog": {
      "type": "array",
      "items": {
        "type": "object"
      }
    }
  }
}
