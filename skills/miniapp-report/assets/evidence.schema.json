{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "Evidence",
  "description": "evidence.json 数组中的单条证据；artifact.file 为可定位的源文件或证据制品路径。",
  "type": "object",
  "required": [
    "evidence_id",
    "source_skill",
    "collected_at",
    "type",
    "artifact",
    "content_redacted"
  ],
  "properties": {
    "evidence_id": {
      "type": "string",
      "pattern": "^EV-[0-9]{3,}$"
    },
    "source_skill": {
      "enum": [
        "miniapp-audit",
        "miniapp-recon",
        "miniapp-threat-model",
        "miniapp-static-audit",
        "miniapp-dynamic",
        "miniapp-report"
      ]
    },
    "collected_at": {
      "type": "string",
      "minLength": 1,
      "pattern": "\\S",
      "format": "date-time"
    },
    "type": {
      "enum": [
        "source_code",
        "config",
        "api_response",
        "tool_output",
        "dynamic_test"
      ]
    },
    "artifact": {
      "type": "object",
      "required": [
        "file"
      ],
      "properties": {
        "file": {
          "type": "string",
          "minLength": 1,
          "pattern": "\\S"
        },
        "line_start": {
          "type": "integer",
          "minimum": 1
        },
        "line_end": {
          "type": "integer",
          "minimum": 1
        },
        "hash": {
          "type": "string",
          "pattern": "^[a-fA-F0-9]{64}$"
        },
        "locator": {
          "type": "string",
          "minLength": 1,
          "pattern": "\\S",
          "description": "JSON Pointer、测试编号或请求记录标识"
        }
      }
    },
    "content_redacted": {
      "type": "string",
      "minLength": 1,
      "pattern": "\\S",
      "description": "实际代码、配置、请求响应或工具结果的脱敏摘录，不接受仅有路径或“已脱敏”等占位说明。"
    },
    "metadata": {
      "type": "object",
      "properties": {
        "tool": {
          "type": "string",
          "minLength": 1,
          "pattern": "\\S"
        },
        "tool_version": {
          "type": "string",
          "minLength": 1,
          "pattern": "\\S"
        },
        "rule_id": {
          "type": "string",
          "minLength": 1,
          "pattern": "\\S"
        },
        "environment": {
          "type": "string",
          "minLength": 1,
          "pattern": "\\S"
        },
        "account_role": {
          "type": "string",
          "minLength": 1,
          "pattern": "\\S"
        },
        "limitations": {
          "type": "string",
          "minLength": 1,
          "pattern": "\\S"
        }
      }
    }
  }
}
