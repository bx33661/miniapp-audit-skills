{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "Finding",
  "description": "findings.json 数组中的单条记录；状态必须明确，不自动补全。",
  "type": "object",
  "required": [
    "finding_id",
    "status",
    "title",
    "category",
    "evidence_level"
  ],
  "properties": {
    "finding_id": {
      "type": "string",
      "pattern": "^F-[0-9]{3,}$"
    },
    "status": {
      "enum": [
        "confirmed",
        "needs_validation",
        "rejected"
      ]
    },
    "title": {
      "type": "string",
      "minLength": 1,
      "pattern": "\\S",
      "maxLength": 100
    },
    "category": {
      "enum": [
        "security",
        "privacy",
        "business_logic",
        "compliance",
        "dependency"
      ]
    },
    "evidence_level": {
      "enum": [
        "E0",
        "E1",
        "E2",
        "E3"
      ]
    },
    "severity": {
      "enum": [
        "CRITICAL",
        "HIGH",
        "MEDIUM",
        "LOW",
        "INFO"
      ]
    },
    "severity_reason": {
      "type": "string",
      "minLength": 1,
      "pattern": "\\S",
      "description": "基于已证明影响、范围与前提的评级理由"
    },
    "priority": {
      "enum": [
        "P0",
        "P1",
        "P2",
        "P3"
      ]
    },
    "confidence": {
      "enum": [
        "HIGH",
        "MEDIUM",
        "LOW"
      ]
    },
    "evidence_refs": {
      "type": "array",
      "uniqueItems": true,
      "minItems": 1,
      "items": {
        "type": "string",
        "pattern": "^EV-[0-9]{3,}$"
      }
    },
    "locations": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "properties": {
          "file": {
            "type": "string",
            "minLength": 1,
            "pattern": "\\S"
          },
          "line": {
            "type": "integer",
            "minimum": 1
          },
          "column": {
            "type": "integer",
            "minimum": 1
          },
          "asset": {
            "type": "string",
            "minLength": 1,
            "pattern": "\\S"
          }
        },
        "anyOf": [
          {
            "required": [
              "file"
            ]
          },
          {
            "required": [
              "asset"
            ]
          }
        ]
      }
    },
    "remediation": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "string",
        "minLength": 1,
        "pattern": "\\S"
      }
    },
    "preconditions": {
      "type": "string",
      "minLength": 1,
      "pattern": "\\S"
    },
    "retest": {
      "type": "string",
      "minLength": 1,
      "pattern": "\\S",
      "description": "具体复测步骤与通过判据；未执行时明确说明，不能伪造通过。"
    },
    "verification": {
      "type": "object",
      "required": [
        "method",
        "test_case"
      ],
      "properties": {
        "method": {
          "enum": [
            "static_analysis",
            "dynamic_test",
            "manual_review"
          ]
        },
        "test_case": {
          "type": "object",
          "required": [
            "expected",
            "actual"
          ],
          "properties": {
            "request": {
              "type": "string",
              "minLength": 1,
              "pattern": "\\S"
            },
            "expected": {
              "type": "string",
              "minLength": 1,
              "pattern": "\\S"
            },
            "actual": {
              "type": "string",
              "minLength": 1,
              "pattern": "\\S"
            }
          }
        }
      }
    },
    "dataflow": {
      "type": "object",
      "description": "保留实际 source/sink/path/transforms/guards、各节点定位与结论不确定性；字段按证据填写，不生成虚构完整路径。",
      "properties": {
        "source": {
          "type": "object",
          "properties": {
            "file": {"type": "string", "minLength": 1, "pattern": "\\S"},
            "line": {"type": "integer", "minimum": 1},
            "asset": {"type": "string", "minLength": 1, "pattern": "\\S"},
            "type": {"type": "string", "minLength": 1, "pattern": "\\S"}
          }
        },
        "transforms": {
          "type": "array",
          "items": {
            "type": "object"
          }
        },
        "guards": {
          "type": "array",
          "items": {
            "type": "object"
          }
        },
        "sink": {
          "type": "object",
          "properties": {
            "file": {"type": "string", "minLength": 1, "pattern": "\\S"},
            "line": {"type": "integer", "minimum": 1},
            "asset": {"type": "string", "minLength": 1, "pattern": "\\S"},
            "type": {"type": "string", "minLength": 1, "pattern": "\\S"}
          }
        },
        "path": {
          "type": "array",
          "items": {"type": "object"}
        },
        "uncertainty": {"type": "string", "minLength": 1, "pattern": "\\S"}
      }
    },
    "references": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1,
        "pattern": "\\S"
      }
    },
    "cwe": {
      "type": "string",
      "pattern": "^CWE-[0-9]+$"
    },
    "rule_id": {
      "type": "string",
      "minLength": 1,
      "pattern": "\\S"
    },
    "description": {
      "type": "string",
      "minLength": 1,
      "pattern": "\\S"
    },
    "asset": {
      "type": "string",
      "minLength": 1,
      "pattern": "\\S"
    },
    "root_cause": {
      "type": "string",
      "minLength": 1,
      "pattern": "\\S"
    },
    "reproduction": {
      "type": "string",
      "minLength": 1,
      "pattern": "\\S"
    },
    "impact": {
      "type": "string",
      "minLength": 1,
      "pattern": "\\S"
    },
    "validation_needed": {
      "type": "string",
      "minLength": 1,
      "pattern": "\\S"
    },
    "rejection_reason": {
      "type": "string",
      "minLength": 1,
      "pattern": "\\S"
    }
  },
  "allOf": [
    {
      "if": {
        "properties": {
          "status": {
            "const": "confirmed"
          }
        },
        "required": [
          "status"
        ]
      },
      "then": {
        "required": [
          "severity",
          "severity_reason",
          "asset",
          "evidence_refs",
          "root_cause",
          "reproduction",
          "impact",
          "remediation",
          "preconditions",
          "verification",
          "retest"
        ],
        "properties": {
          "evidence_level": {
            "enum": [
              "E2",
              "E3"
            ]
          }
        }
      },
      "else": {
        "not": {
          "required": [
            "severity"
          ]
        }
      }
    },
    {
      "if": {
        "properties": {
          "status": {
            "const": "needs_validation"
          }
        },
        "required": [
          "status"
        ]
      },
      "then": {
        "required": [
          "validation_needed"
        ]
      }
    },
    {
      "if": {
        "properties": {
          "status": {
            "const": "rejected"
          }
        },
        "required": [
          "status"
        ]
      },
      "then": {
        "required": [
          "rejection_reason"
        ]
      }
    }
  ]
}
