{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://wxray.dev/schemas/finding.schema.json",
  "title": "Finding",
  "description": "安全发现记录",
  "type": "object",
  "required": ["finding_id", "severity", "title", "category", "locations"],
  "properties": {
    "finding_id": {
      "type": "string",
      "pattern": "^F-[0-9]{3,}$",
      "description": "发现唯一ID，格式：F-001"
    },
    "rule_id": {
      "type": "string",
      "description": "对应的规则ID",
      "examples": ["SEC-001", "PRIV-002", "BIZ-003"]
    },
    "severity": {
      "type": "string",
      "enum": ["CRITICAL", "HIGH", "MEDIUM", "LOW", "INFO"],
      "description": "严重程度"
    },
    "confidence": {
      "type": "string",
      "enum": ["HIGH", "MEDIUM", "LOW"],
      "default": "MEDIUM",
      "description": "置信度"
    },
    "evidence_level": {
      "type": "string",
      "enum": ["E0", "E1", "E2", "E3"],
      "description": "证据等级；E0/E1 为假设，E2/E3 为已确认"
    },
    "status": {
      "type": "string",
      "enum": ["verified", "confirmed", "server_confirmation_needed", "tool_candidate", "false_positive"],
      "default": "verified",
      "description": "发现状态"
    },
    "title": {
      "type": "string",
      "maxLength": 100,
      "description": "发现标题"
    },
    "description": {
      "type": "string",
      "description": "详细描述"
    },
    "category": {
      "type": "string",
      "enum": ["security", "privacy", "business_logic", "compliance", "dependency", "quality"],
      "description": "问题分类"
    },
    "cwe": {
      "type": "string",
      "pattern": "^CWE-[0-9]+$",
      "description": "CWE编号",
      "examples": ["CWE-798", "CWE-89"]
    },
    "locations": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["file", "line"],
        "properties": {
          "file": {
            "type": "string",
            "description": "文件路径"
          },
          "line": {
            "type": "integer",
            "minimum": 1,
            "description": "行号"
          },
          "column": {
            "type": "integer",
            "minimum": 1,
            "description": "列号（可选）"
          }
        }
      },
      "description": "问题位置列表"
    },
    "evidence_refs": {
      "type": "array",
      "items": {
        "type": "string",
        "pattern": "^EV-[0-9]{3,}$"
      },
      "description": "关联的证据ID列表"
    },
    "dataflow": {
      "type": "object",
      "description": "数据流信息",
      "properties": {
        "source": {
          "type": "object",
          "properties": {
            "file": {"type": "string"},
            "line": {"type": "integer"},
            "type": {"type": "string", "examples": ["user_input", "url_param", "storage"]}
          }
        },
        "transforms": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "file": {"type": "string"},
              "line": {"type": "integer"},
              "operation": {"type": "string", "examples": ["concat", "encode", "encrypt"]}
            }
          }
        },
        "guards": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "file": {"type": "string"},
              "line": {"type": "integer"},
              "type": {"type": "string", "examples": ["validation", "sanitization", "escape"]}
            }
          }
        },
        "sink": {
          "type": "object",
          "properties": {
            "file": {"type": "string"},
            "line": {"type": "integer"},
            "type": {"type": "string", "examples": ["sql_query", "command", "log", "http_request"]}
          }
        }
      }
    },
    "asset": {
      "type": "string",
      "description": "受影响资产：端点、云函数、页面或存储路径"
    },
    "root_cause": {
      "type": "string",
      "description": "失效的信任边界和缺失的服务端控制"
    },
    "reproduction": {
      "type": "string",
      "description": "可复现步骤，密钥和个人信息已脱敏"
    },
    "impact": {
      "type": "string",
      "description": "影响描述"
    },
    "remediation": {
      "type": "array",
      "items": {"type": "string"},
      "description": "修复建议列表"
    },
    "verification": {
      "type": "object",
      "description": "验证信息",
      "properties": {
        "method": {
          "type": "string",
          "enum": ["static_analysis", "dynamic_test", "manual_review"],
          "description": "验证方法"
        },
        "test_case": {
          "type": "object",
          "description": "测试用例（动态测试时）",
          "properties": {
            "request": {"type": "string"},
            "expected": {"type": "string"},
            "actual": {"type": "string"}
          }
        }
      }
    },
    "references": {
      "type": "array",
      "items": {"type": "string"},
      "description": "参考资料链接"
    }
  }
}
