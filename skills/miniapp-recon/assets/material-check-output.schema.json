{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "Material inventory",
  "description": "COMPLETE仅表示已检查的声明结构齐备，不证明版本一致、业务完整或安全。",
  "type": "object",
  "required": [
    "skill",
    "scanned_at",
    "input_path",
    "material_type",
    "completeness",
    "metadata",
    "main_package",
    "subpackages",
    "plugins",
    "quality",
    "coverage_notes"
  ],
  "properties": {
    "skill": {
      "const": "miniapp-recon"
    },
    "scanned_at": {
      "type": "string",
      "format": "date-time"
    },
    "input_path": {
      "type": "string",
      "minLength": 1,
      "pattern": "\\S"
    },
    "material_type": {
      "enum": [
        "wxapkg",
        "wechat_cache",
        "decompiled_source",
        "unknown"
      ]
    },
    "completeness": {
      "enum": [
        "COMPLETE",
        "PARTIAL",
        "CONFLICTED",
        "BLOCKED"
      ]
    },
    "metadata": {
      "type": "object",
      "required": [
        "app_id",
        "pages_count"
      ],
      "properties": {
        "app_id": {
          "type": ["string", "null"],
          "minLength": 1,
          "pattern": "\\S"
        },
        "app_name": {
          "type": "string"
        },
        "pages_count": {
          "type": ["integer", "null"],
          "minimum": 0
        },
        "subpackages_count": {
          "type": ["integer", "null"],
          "minimum": 0
        },
        "plugins_count": {
          "type": ["integer", "null"],
          "minimum": 0
        }
      }
    },
    "main_package": {
      "type": "object",
      "required": [
        "status",
        "issues"
      ],
      "properties": {
        "status": {
          "enum": [
            "OK",
            "ISSUES",
            "UNKNOWN"
          ]
        },
        "issues": {
          "type": "array",
          "items": {
            "$ref": "#/definitions/issue"
          }
        }
      }
    },
    "subpackages": {
      "type": "object",
      "required": [
        "declared",
        "found",
        "missing",
        "issues"
      ],
      "properties": {
        "declared": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1,
            "pattern": "\\S"
          },
          "uniqueItems": true
        },
        "found": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1,
            "pattern": "\\S"
          },
          "uniqueItems": true
        },
        "missing": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1,
            "pattern": "\\S"
          },
          "uniqueItems": true
        },
        "issues": {
          "type": "array",
          "items": {
            "$ref": "#/definitions/issue"
          }
        }
      }
    },
    "plugins": {
      "type": "object",
      "required": [
        "declared",
        "issues"
      ],
      "properties": {
        "declared": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1,
            "pattern": "\\S"
          },
          "uniqueItems": true
        },
        "issues": {
          "type": "array",
          "items": {
            "$ref": "#/definitions/issue"
          }
        }
      }
    },
    "quality": {
      "type": "object",
      "required": [
        "version_consistency",
        "decompile_quality",
        "issues"
      ],
      "properties": {
        "version_consistency": {
          "enum": [
            "OK",
            "ISSUES",
            "UNKNOWN"
          ]
        },
        "decompile_quality": {
          "enum": [
            "OK",
            "ISSUES",
            "UNKNOWN"
          ]
        },
        "issues": {
          "type": "array",
          "items": {
            "anyOf": [
              {
                "type": "string",
                "minLength": 1,
                "pattern": "\\S"
              },
              {
                "$ref": "#/definitions/issue"
              }
            ]
          }
        }
      }
    },
    "coverage_notes": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1,
        "pattern": "\\S"
      },
      "uniqueItems": true
    },
    "next_actions": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1,
        "pattern": "\\S"
      },
      "uniqueItems": true
    }
  },
  "definitions": {
    "issue": {
      "type": "object",
      "required": [
        "type",
        "impact"
      ],
      "properties": {
        "type": {
          "type": "string",
          "minLength": 1,
          "pattern": "\\S"
        },
        "impact": {
          "type": "string",
          "minLength": 1,
          "pattern": "\\S"
        },
        "file": {
          "type": "string",
          "minLength": 1,
          "pattern": "\\S"
        },
        "subpackage": {
          "type": "string",
          "minLength": 1,
          "pattern": "\\S"
        },
        "plugin": {
          "type": "string",
          "minLength": 1,
          "pattern": "\\S"
        }
      },
      "additionalProperties": true,
      "not": {
        "required": [
          "severity"
        ]
      }
    }
  }
}
