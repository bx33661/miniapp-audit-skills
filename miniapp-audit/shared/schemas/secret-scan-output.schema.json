{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://wxray.dev/schemas/secret-scan-output.schema.json",
  "title": "Secret Scan Output",
  "description": "凭证扫描输出格式",
  "type": "object",
  "required": ["skill", "scanned_at", "source_dir", "statistics", "secrets"],
  "properties": {
    "skill": {
      "type": "string",
      "const": "secret-scan"
    },
    "scanned_at": {
      "type": "string",
      "format": "date-time"
    },
    "source_dir": {
      "type": "string"
    },
    "tool_used": {
      "type": "string",
      "enum": ["gitleaks", "trufflehog", "ripgrep", "custom_script"],
      "description": "使用的扫描工具"
    },
    "tool_version": {
      "type": "string",
      "description": "工具版本"
    },
    "statistics": {
      "type": "object",
      "required": ["files_scanned", "total_matches", "after_filtering"],
      "properties": {
        "files_scanned": {
          "type": "integer",
          "minimum": 0
        },
        "total_matches": {
          "type": "integer",
          "minimum": 0
        },
        "after_filtering": {
          "type": "integer",
          "minimum": 0
        },
        "by_severity": {
          "type": "object",
          "properties": {
            "CRITICAL": {"type": "integer"},
            "HIGH": {"type": "integer"},
            "MEDIUM": {"type": "integer"},
            "LOW": {"type": "integer"}
          }
        }
      }
    },
    "secrets": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["evidence_id", "type", "value_masked", "file", "line", "severity"],
        "properties": {
          "evidence_id": {
            "type": "string",
            "pattern": "^EV-[0-9]{3,}$"
          },
          "type": {
            "type": "string",
            "enum": [
              "api_key",
              "secret_key",
              "access_token",
              "aws_key",
              "cloud_key",
              "private_key",
              "database_connection",
              "wechat_appsecret",
              "mobile_phone",
              "id_card",
              "email",
              "jwt_token",
              "payment_key"
            ]
          },
          "value_masked": {
            "type": "string",
            "description": "脱敏后的值"
          },
          "file": {
            "type": "string",
            "description": "文件路径（相对于源码根目录）"
          },
          "line": {
            "type": "integer",
            "minimum": 1
          },
          "severity": {
            "type": "string",
            "enum": ["CRITICAL", "HIGH", "MEDIUM", "LOW"]
          },
          "confidence": {
            "type": "string",
            "enum": ["HIGH", "MEDIUM", "LOW"],
            "default": "MEDIUM"
          },
          "context": {
            "type": "string",
            "description": "代码上下文（已脱敏）"
          },
          "rule_id": {
            "type": "string",
            "description": "匹配的规则ID"
          },
          "recommendation": {
            "type": "string",
            "description": "修复建议"
          }
        }
      }
    },
    "false_positives": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "file": {"type": "string"},
          "line": {"type": "integer"},
          "matched_text": {"type": "string"},
          "reason": {"type": "string"}
        }
      },
      "description": "被过滤的误报"
    }
  }
}
